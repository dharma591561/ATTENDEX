# ATTENDX — Environment Configuration Example

# Server Environment
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# SQLite Persistent Database Path
DATABASE_PATH=./data/attendx.db

# Session Secret (used for signing and hashing internal verification tokens)
SESSION_SECRET=attendx_super_secure_random_session_secret_change_in_production

# Real SMTP Email Configuration (Nodemailer)
# To use Gmail SMTP:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your email and the 16-character App Password below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_university_email@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM="ATTENDX College Portal <noreply@attendx.edu>"

# Gemini AI API Key (Injected automatically in AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
